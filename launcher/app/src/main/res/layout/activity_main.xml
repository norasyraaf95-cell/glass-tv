<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Atmospheric motion runs behind content and is stopped when Home is paused. -->
    <com.gathin.tvhome.WindyCloudView
        android:id="@+id/cloudMotion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Fixed reference reflection behind the dock, never animated by DPAD. -->
    <ImageView
        android:id="@+id/dockStaticReflection"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:alpha="0.9"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the place's name, its country and what it is about, positioned above the dock in code.
         The width is capped in code to a share of the space between the side paddings, so the
         description wraps in a column instead of running the width of the screen. -->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.75"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- The country close under the name, and the description a little further below it. -->
        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1.5dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.5dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Reference clock: Malay date above oversized white digits, no circle. -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:orientation="vertical"
                android:layout_marginTop="75dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:id="@+id/dateBlock"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:textColor="#F3FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit" />
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wednesday  |  18 Nov 2026"
                        android:textColor="#ECFFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">
                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="80sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 750"
                        android:letterSpacing="-0.06"
                        android:includeFontPadding="false" />
                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="17dp"
                        android:includeFontPadding="false"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#E6FFFFFF"
                        android:textSize="19sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 550" />
                </LinearLayout>
                <View
                    android:layout_width="242dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/custom_clock_glow"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="0dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

    <!-- Reference-inspired top bar: prayer strip to the left, petite weather card to the right.
         All data is live/cached, unlike the frozen numbers in the video mockup. -->
    <LinearLayout
        android:id="@+id/shahAlamCards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/customPrayerCard"
            android:layout_width="395dp"
            android:layout_height="55dp"
            android:background="@drawable/custom_widget_glass"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="false">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_custom_mosque"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/customPrayerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prayer Times"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:maxLines="1" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shah Alam · SGR01"
                    android:textColor="#CBE5D5EF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Kept for backward compatibility with ShahAlamWidgets controller. -->
            <TextView
                android:id="@+id/customPrayerTime"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/customPrayerStrip"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">
                <TextView android:id="@+id/prayerFajr" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center" android:text="Fajr&#10;--:--"
                    android:textSize="12sp" android:lineSpacingExtra="2dp" android:textColor="#E5FFFFFF"
                    android:fontFamily="@font/outfit" android:includeFontPadding="false" />
                <View
                    android:layout_width="1dp"
                    android:layout_height="23dp"
                    android:background="#75FFFFFF"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/prayerDhuhr" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center" android:text="Dhuhr&#10;--:--"
                    android:textSize="12sp" android:lineSpacingExtra="2dp" android:textColor="#E5FFFFFF"
                    android:fontFamily="@font/outfit" android:includeFontPadding="false" />
                <View
                    android:layout_width="1dp"
                    android:layout_height="23dp"
                    android:background="#75FFFFFF"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/prayerAsr" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center" android:text="Asr&#10;--:--"
                    android:textSize="12sp" android:lineSpacingExtra="2dp" android:textColor="#E5FFFFFF"
                    android:fontFamily="@font/outfit" android:includeFontPadding="false" />
                <View
                    android:layout_width="1dp"
                    android:layout_height="23dp"
                    android:background="#75FFFFFF"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/prayerMaghrib" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center" android:text="Maghrib&#10;--:--"
                    android:textSize="12sp" android:lineSpacingExtra="2dp" android:textColor="#E5FFFFFF"
                    android:fontFamily="@font/outfit" android:includeFontPadding="false" />
                <View
                    android:layout_width="1dp"
                    android:layout_height="23dp"
                    android:background="#75FFFFFF"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/prayerIsha" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:gravity="center" android:text="Isha&#10;--:--"
                    android:textSize="12sp" android:lineSpacingExtra="2dp" android:textColor="#E5FFFFFF"
                    android:fontFamily="@font/outfit" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/customWeatherCard"
            android:layout_width="154dp"
            android:layout_height="55dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/custom_widget_glass"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusDown="@id/grid"
            android:contentDescription="Shah Alam weather. Press OK to toggle cloud motion.">

            <ImageView
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/ic_custom_weather"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/customWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/customWeatherCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shah Alam"
                    android:textColor="#DEFFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/customCloudToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="WINDY · ON"
                    android:visibility="gone"
                    android:textColor="#FFDFB7EC"
                    android:textSize="8sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
