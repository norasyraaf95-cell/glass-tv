<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle">
                <solid android:color="#C421162D" />
                <corners android:radius="18dp" />
                <stroke android:width="5dp" android:color="#68F633B7" />
            </shape></item>
            <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#D1291938"
                        android:endColor="#D522172F" />
                    <corners android:radius="15dp" />
                    <stroke android:width="2dp" android:color="#FFFF5BC7" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#CB271B36"
                android:endColor="#D31C172B" />
            <corners android:radius="17dp" />
            <stroke android:width="1dp" android:color="#A68B799D" />
        </shape>
    </item>
</selector>